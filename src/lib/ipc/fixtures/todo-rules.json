        {
          "op": "create",
          "title": "h2",
          "list": 0
        },
        {
          "op": "create",
          "title": "w1",
          "list": 1
        },
        {
          "op": "create",
          "title": "i1"
        },
        {
          "op": "complete",
          "task": 1
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": {
            "list": 1
          }
        }
      ],
      "expect": {
        "results": ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"],
        "lists": ["Work"],
        "all": [["Inbox", ["i1"]], ["Work", ["h1", "w1"]]],
        "counts": [1, 2]
      }
    },
    {
      "rule": "list.delete.empty",
      "name": "an empty List deletes whatever the choice",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "delete"
        }
      ],
      "expect": {
        "results": ["ok", "ok"],
        "lists": []
      }
    },
    {
      "rule": "list.delete.target",
      "name": "moving into the deleted List itself is refused",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "create",
          "title": "a",
          "list": 0
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": {
            "list": 0
          }
        }
      ],
      "expect": {
        "results": ["ok", "ok", "validation"],
        "lists": ["Home"],
        "counts": [0, 1]
      }
    },
    {
      "rule": "list.delete.target",
      "name": "moving into an unknown List is refused",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "create",
          "title": "a",
          "list": 0
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": {
            "list": "nope"
          }
        }
      ],
      "expect": {
        "results": ["ok", "ok", "not_found"],
        "lists": ["Home"],
        "counts": [0, 1]
      }
    },
    {
      "rule": "list.delete.missing",
      "name": "deleting an unknown List is not found",
      "steps": [
        {
          "op": "list_delete",
          "list": "nope",
          "choice": "delete"
        }
      ],
      "expect": {
        "results": ["not_found"]
      }
    },
    {
      "rule": "list.delete.twice",
      "name": "deleting a deleted List is not found",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "delete"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "delete"
        }
      ],
      "expect": {
        "results": ["ok", "ok", "not_found"]
      }
    },
    {
      "rule": "list.delete.name_free",
      "name": "a deleted List's name can be used again",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "delete"
        },
        {
          "op": "list_create",
          "name": "home"
        }
      ],
      "expect": {
        "results": ["ok", "ok", "ok"],
        "lists": ["home"]
      }
    },
    {
      "rule": "list.restore.tasks",
      "name": "restoring brings back the List and its Tasks in place",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_create",
          "name": "Work"
        },
        {
          "op": "create",
          "title": "h1",
          "list": 0
        },
        {
          "op": "create",
          "title": "h2",
          "list": 0
        },
        {
          "op": "create",
          "title": "w1",
          "list": 1
        },
        {
          "op": "create",
          "title": "i1"
        },
        {
          "op": "complete",
          "task": 1
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "delete"
        },
        {
          "op": "list_restore",
          "deletion": 0
        }
      ],
      "expect": {
        "results": ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"],
        "lists": ["Home", "Work"],
        "all": [["Inbox", ["i1"]], ["Home", ["h1"]], ["Work", ["w1"]]],
        "counts": [1, 1, 1]
      }
    },
    {
      "rule": "list.restore.inbox",
      "name": "restoring after a move to the Inbox sends the Tasks home",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_create",
          "name": "Work"
        },
        {
          "op": "create",
          "title": "h1",
          "list": 0
        },
        {
          "op": "create",
          "title": "h2",
          "list": 0
        },
        {
          "op": "create",
          "title": "w1",
          "list": 1
        },
        {
          "op": "create",
          "title": "i1"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "inbox"
        },
        {
          "op": "list_restore",
          "deletion": 0
        }
      ],
      "expect": {
        "lists": ["Home", "Work"],
        "inbox": ["i1"],
        "counts": [1, 2, 1]
      }
    },
    {
      "rule": "list.restore.list",
      "name": "restoring after a move to a List sends the Tasks home",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_create",
          "name": "Work"
        },
        {
          "op": "create",
          "title": "h1",
          "list": 0
        },
        {
          "op": "create",
          "title": "h2",
          "list": 0
        },
        {
          "op": "create",
          "title": "w1",
          "list": 1
        },
        {
          "op": "create",
          "title": "i1"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": {
            "list": 1
          }
        },
        {
          "op": "list_restore",
          "deletion": 0
        }
      ],
      "expect": {
        "lists": ["Home", "Work"],
        "counts": [1, 2, 1]
      }
    },
    {
      "rule": "list.restore.order",
      "name": "a restored List returns to its old place",
      "steps": [
        {
          "op": "list_create",
          "name": "a"
        },
        {
          "op": "list_create",
          "name": "b"
        },
        {
          "op": "list_create",
          "name": "c"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "delete"
        },
        {
          "op": "list_restore",
          "deletion": 0
        }
      ],
      "expect": {
        "lists": ["a", "b", "c"]
      }
    },
    {
      "rule": "list.restore.name_taken",
      "name": "restoring is refused when the name was taken meanwhile",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "delete"
        },
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_restore",
          "deletion": 0
        }
      ],
      "expect": {
        "results": ["ok", "ok", "ok", "validation"],
        "lists": ["Home"]
      }
    },
    {
      "rule": "list.restore.live",
      "name": "restoring a live List is refused",
      "steps": [
        {
          "op": "list_create",
          "name": "Home"
        },
        {
          "op": "list_delete",
          "list": 0,
          "choice": "delete"
        },
        {
          "op": "list_restore",
          "deletion": 0
        },
        {
          "op": "list_restore",
          "deletion": 0
        }
      ],
      "expect": {
        "results": ["ok", "ok", "ok", "validation"]
      }
    }
  ]
}
