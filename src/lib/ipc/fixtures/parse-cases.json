{
  "about": "Cases shared by the Rust parser (crates/todo/src/parse.rs) and its TypeScript copy (src/lib/ipc/mock-todo-parse.ts). Each case is a todo_parse request (text, ignored, prefer, frozen, today, now, week_start) plus the lists #Name may match; defaults fill what a case leaves out. expect.spans and .ignored are [word, kind, value], .alternatives add the reason; every other key is compared with the same field of the result. 2026-10-21 is a Wednesday.",
  "defaults": {
    "today": "2026-10-21",
    "now": "14:05",
    "week_start": "mon",
    "ignored": [],
    "prefer": {},
    "frozen": [],
    "lists": [
      {
        "id": "l-home",
        "name": "Home"
      },
      {
        "id": "l-work",
        "name": "Work"
      },
      {
        "id": "l-side",
        "name": "Side projects"
      }
    ]
  },
  "cases": [
    {
      "name": "today",
      "text": "Call mum today",
      "expect": {
        "spans": [["today", "date", "2026-10-21"]],
        "date": "2026-10-21",
        "time": null
      }
    },
    {
      "name": "tomorrow",
      "text": "Call mum tomorrow",
      "expect": {
        "spans": [["tomorrow", "date", "2026-10-22"]],
        "date": "2026-10-22"
      }
    },
    {
      "name": "tmr is tomorrow",
      "text": "Call mum tmr",
      "expect": {
        "spans": [["tmr", "date", "2026-10-22"]],
        "date": "2026-10-22"
      }
    },
    {
      "name": "tonight is today at 20:00",
      "text": "Dinner tonight",
      "expect": {
        "spans": [["tonight", "date", "2026-10-21"], ["tonight", "time", "20:00"]],
        "date": "2026-10-21",
        "time": "20:00"
      }
    },
    {
      "name": "an explicit time beats tonight's",
      "text": "Dinner tonight at 9pm",
      "expect": {
        "spans": [["tonight", "date", "2026-10-21"], ["at 9pm", "time", "21:00"]],
        "date": "2026-10-21",
        "time": "21:00",
        "alternatives": [["tonight", "time", "20:00", "conflict"]]
      }
    },
    {
      "name": "a weekday",
      "text": "Gym fri",
      "expect": {
        "spans": [["fri", "date", "2026-10-23"]],
        "date": "2026-10-23"
      }
    },
    {
      "name": "on a weekday",
      "text": "Gym on friday",
      "expect": {
        "spans": [["on friday", "date", "2026-10-23"]],
        "date": "2026-10-23"
      }
    },
    {
      "name": "the same weekday is today",
      "text": "Gym wed",
      "expect": {
        "spans": [["wed", "date", "2026-10-21"]],
        "date": "2026-10-21"
      }
    },
    {
      "name": "an earlier weekday is next week",
      "text": "Gym on mon",
      "expect": {
        "spans": [["on mon", "date", "2026-10-26"]],
        "date": "2026-10-26"
      }
    },
    {
      "name": "next fri is the Friday of next week",
      "text": "Gym next fri",
      "expect": {
        "spans": [["next fri", "date", "2026-10-30"]],
        "date": "2026-10-30"
      }
    },
    {
      "name": "next sun ends next week when weeks start on Monday",
      "text": "Gym next sun",
      "expect": {
        "spans": [["next sun", "date", "2026-11-01"]]
      }
    },
    {
      "name": "next sun starts next week when weeks start on Sunday",
      "text": "Gym next sun",
      "expect": {
        "spans": [["next sun", "date", "2026-10-25"]]
      },
      "week_start": "sun"
    },
    {
      "name": "next wed is a week on",
      "text": "Gym next wed",
      "expect": {
        "spans": [["next wed", "date", "2026-10-28"]]
      }
    },
    {
      "name": "21 oct on the 21st is today",
      "text": "Pay 21 oct",
      "expect": {
        "spans": [["21 oct", "date", "2026-10-21"]]
      }
    },
    {
      "name": "oct 25",
      "text": "Pay oct 25",
      "expect": {
        "spans": [["oct 25", "date", "2026-10-25"]]
      }
    },
    {
      "name": "3 nov",
      "text": "Pay 3 nov",
      "expect": {
        "spans": [["3 nov", "date", "2026-11-03"]]
      }
