      "name": "this weekend on a Sunday is today",
      "text": "Hike this weekend",
      "expect": {
        "spans": [["this weekend", "date", "2026-10-25"]]
      },
      "today": "2026-10-25"
    },
    {
      "name": "next month is the 1st",
      "text": "Review next month",
      "expect": {
        "spans": [["next month", "date", "2026-11-01"]]
      }
    },
