      "text": "Pay rent tomorrow to tell today",
      "expect": {
        "spans": [["tomorrow", "date", "2026-10-22"]],
        "date": "2026-10-22",
        "alternatives": [["today", "date", "2026-10-21", "conflict"]]
      },
      "prefer": {
        "date": "date:tomorrow:1"
      }
    },
    {
      "name": "a pick for a word that is gone falls back to the last",
      "text": "Pay rent tomorrow to tell today",
      "expect": {
        "spans": [["today", "date", "2026-10-21"]]
      },
      "prefer": {
        "date": "date:friday:1"
      }
    },
    {
      "name": "a word kept as text has no effect",
      "text": "Pay rent tomorrow",
      "expect": {
        "spans": [],
        "date": null,
        "ignored": [["tomorrow", "date", "2026-10-22"]]
      },
      "ignored": ["date:tomorrow:1"]
    },
    {
      "name": "ignoring the last lets the earlier win",
      "text": "Pay rent tomorrow to tell today",
      "expect": {
        "spans": [["tomorrow", "date", "2026-10-22"]],
        "date": "2026-10-22",
        "alternatives": [],
        "ignored": [["today", "date", "2026-10-21"]]
      },
      "ignored": ["date:today:1"]
    },
    {
      "name": "two priorities: the last wins",
      "text": "p1 then p3",
      "expect": {
        "spans": [["p3", "prio", "3"]],
        "priority": 3,
        "alternatives": [["p1", "prio", "1", "conflict"]]
      }
    },
    {
      "name": "two Lists: the last wins",
      "text": "x #ho and #wo",
      "expect": {
        "spans": [["#wo", "list", "Work"]],
        "list_id": "l-work",
        "alternatives": [["#ho", "list", "Home", "conflict"]]
      }
    },
    {
      "name": "two Repeats: the last wins",
      "text": "daily or weekly",
      "expect": {
        "spans": [
          ["weekly", "repeat", "{\"freq\":\"week\",\"every\":1,\"days\":null,\"mode\":\"fixed\"}"]
        ],
        "alternatives": [
          [
            "daily",
            "repeat",
            "{\"freq\":\"day\",\"every\":1,\"days\":null,\"mode\":\"fixed\"}",
            "conflict"
          ]
        ]
      }
    },
    {
      "name": "two times: the last wins",
      "text": "at 9am or 3pm",
      "expect": {
        "spans": [["3pm", "time", "15:00"]],
        "time": "15:00",
        "alternatives": [["at 9am", "time", "09:00", "conflict"]]
      }
    },
    {
      "name": "a frozen stretch is not read again",
      "text": "Pay rent tomorrow fri",
      "expect": {
        "spans": [["fri", "date", "2026-10-23"]],
        "date": "2026-10-23",
        "alternatives": [],
        "ignored": []
      },
      "frozen": [
        {
          "start": 0,
          "end": 17
        }
      ]
    },
    {
      "name": "a word only partly frozen is still read",
      "text": "Pay rent tomorrow",
      "expect": {
        "spans": [["tomorrow", "date", "2026-10-22"]]
      },
      "frozen": [
        {
          "start": 0,
          "end": 12
        }
      ]
    },
    {
      "name": "offsets count UTF-16 units",
      "text": "Party 🎉 tomorrow",
      "expect": {
        "spans": [["tomorrow", "date", "2026-10-22"]]
      }
    },
    {
      "name": "empty text reads nothing",
      "text": "",
      "expect": {
        "spans": [],
        "date": null,
        "time": null,
        "repeat": null,
        "priority": null
      }
    }
  ]
}
