{
  "about": "Rules shared by the Rust commands (src-tauri/src/sync.rs) and the browser mock (src/lib/ipc/mock-sync.test.ts). See ADR 0009. Each case renames this device with `input`: it is refused (`error` is the code and message) or saved as `saved`.",
  "name_cases": [
    { "name": "a plain name", "input": "Pixel 8", "saved": "Pixel 8" },
    { "name": "surrounding spaces are trimmed", "input": "  Pixel 8 ", "saved": "Pixel 8" },
    { "name": "an accented name", "input": "Hemang’s Mac", "saved": "Hemang’s Mac" },
    {
      "name": "forty characters are fine",
      "input": "abcdefghijabcdefghijabcdefghijabcdefghij",
      "saved": "abcdefghijabcdefghijabcdefghijabcdefghij"
    },
    {
      "name": "forty accented characters are fine (characters, not bytes)",
      "input": "éééééééééééééééééééééééééééééééééééééééé",
      "saved": "éééééééééééééééééééééééééééééééééééééééé"
    },
    {
      "name": "forty-one characters are refused",
      "input": "abcdefghijabcdefghijabcdefghijabcdefghijk",
      "error": { "code": "validation", "message": "A device name is at most 40 characters" }
    },
    {
      "name": "an empty name is refused",
      "input": "",
      "error": { "code": "validation", "message": "Give this device a name" }
    },
    {
      "name": "a blank name is refused",
      "input": "   ",
      "error": { "code": "validation", "message": "Give this device a name" }
    }
  ]
}
