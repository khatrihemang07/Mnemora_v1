      "suggestion": {
        "kind": "list",
        "id": "l-home",
        "name": "Home",
        "emoji": "🏠"
      },
      "expected": {
        "text": "buy #Home ",
        "caret": 10
      }
    },
    {
      "name": "keeps the text after it",
      "text": "buy #ho milk",
      "hash": {
        "start": 4,
