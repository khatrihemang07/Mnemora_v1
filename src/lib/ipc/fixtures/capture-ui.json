{
  "about": "Pure rules of the Quick add / Capture box (src/modules/todo/capture.ts) that the Todo widget's native sheet repeats in Kotlin (CaptureRules.kt). The same cases run in Vitest against the TypeScript helpers (capture.test.ts) and in JUnit against the Kotlin port (CaptureRulesTest.kt). Offsets are UTF-16 units. Quick edit helpers (unchangedRanges, pasteIntoTitle) and resolveFields are not ported here: resolveFields is Rust in the widget (capture-resolve.json).",
  "ignore_word": [
    {
      "name": "keeps a word as text",
      "words": {
        "ignored": [],
        "prefer": {}
      },
      "key": "date:tomorrow:1",
      "expected": {
        "ignored": ["date:tomorrow:1"],
        "prefer": {}
      }
    },
    {
      "name": "once",
      "words": {
        "ignored": ["date:tomorrow:1"],
        "prefer": {}
      },
      "key": "date:tomorrow:1",
      "expected": {
        "ignored": ["date:tomorrow:1"],
        "prefer": {}
      }
    },
    {
      "name": "forgets a use-instead for that word",
      "words": {
        "ignored": [],
        "prefer": {
          "date": "date:fri:1",
          "time": "time:9:1"
        }
      },
      "key": "date:fri:1",
      "expected": {
        "ignored": ["date:fri:1"],
        "prefer": {
          "time": "time:9:1"
        }
      }
    }
  ],
  "recognise_again": [
    {
      "name": "reads a kept word again",
      "words": {
        "ignored": ["a", "b"],
        "prefer": {
          "date": "c"
        }
      },
      "key": "a",
      "expected": {
        "ignored": ["b"],
        "prefer": {
          "date": "c"
        }
      }
    },
    {
      "name": "a word that was not kept changes nothing",
      "words": {
        "ignored": ["a"],
        "prefer": {}
      },
      "key": "z",
      "expected": {
        "ignored": ["a"],
        "prefer": {}
      }
    }
  ],
  "prefer_word": [
    {
      "name": "chooses a word over the winner",
      "words": {
        "ignored": [],
        "prefer": {}
      },
      "span": {
        "kind": "date",
        "key": "date:fri:1"
      },
      "expected": {
        "ignored": [],
        "prefer": {
          "date": "date:fri:1"
        }
      }
    },
    {
      "name": "a later choice replaces an earlier one of the same kind",
      "words": {
        "ignored": [],
        "prefer": {
          "date": "date:fri:1",
          "time": "t"
        }
      },
      "span": {
        "kind": "date",
        "key": "date:mon:1"
      },
      "expected": {
        "ignored": [],
        "prefer": {
          "date": "date:mon:1",
          "time": "t"
        }
      }
    }
  ],
  "ignore_kinds": [
    {
      "name": "the words of a hand-set kind become text",
      "words": {
        "ignored": [],
        "prefer": {}
      },
      "spans": [
        {
          "kind": "prio",
          "key": "prio:p1:1"
        },
        {
          "kind": "date",
          "key": "date:fri:1"
        }
      ],
      "alternatives": [
        {
          "kind": "prio",
          "key": "prio:p3:1"
        }
      ],
      "kinds": ["prio"],
      "expected": {
        "ignored": ["prio:p1:1", "prio:p3:1"],
        "prefer": {}
      }
    },
    {
      "name": "forgets a use-instead of those kinds, keeps the others",
      "words": {
        "ignored": ["x"],
        "prefer": {
          "list": "list:#a:1",
          "date": "date:fri:1"
        }
      },
      "spans": [],
      "alternatives": [],
      "kinds": ["list"],
      "expected": {
        "ignored": ["x"],
        "prefer": {
          "date": "date:fri:1"
        }
      }
    },
    {
      "name": "no duplicates",
      "words": {
        "ignored": ["prio:p1:1"],
        "prefer": {}
      },
      "spans": [
        {
          "kind": "prio",
          "key": "prio:p1:1"
        }
      ],
      "alternatives": [],
      "kinds": ["prio"],
      "expected": {
        "ignored": ["prio:p1:1"],
        "prefer": {}
      }
    }
  ],
  "prune_words": [
    {
      "name": "forgets words that left the text",
      "words": {
        "ignored": ["a", "b"],
        "prefer": {
          "date": "a",
          "time": "gone"
        }
      },
      "known": ["a"],
      "expected": {
        "ignored": ["a"],
        "prefer": {
          "date": "a"
        }
      }
    },
    {
      "name": "nothing to forget",
      "words": {
        "ignored": ["a"],
        "prefer": {
          "date": "a"
        }
      },
      "known": ["a", "b"],
      "expected": {
        "ignored": ["a"],
        "prefer": {
          "date": "a"
        }
      }
    }
  ],
  "backspace_target": [
    {
      "name": "right after a word",
      "text": "call mum tomorrow",
      "selection_start": 17,
      "selection_end": 17,
      "spans": [
        {
          "key": "date:tomorrow:1",
          "end": 17
        }
      ],
      "just_unrecognised": false,
      "expected": "date:tomorrow:1"
    },
    {
      "name": "after the one space that follows it",
      "text": "call mum tomorrow ",
      "selection_start": 18,
      "selection_end": 18,
      "spans": [
        {
          "key": "date:tomorrow:1",
          "end": 17
        }
      ],
      "just_unrecognised": false,
      "expected": "date:tomorrow:1"
    },
    {
      "name": "two spaces after is a plain delete",
      "text": "call mum tomorrow  ",
      "selection_start": 19,
      "selection_end": 19,
      "spans": [
        {
          "key": "date:tomorrow:1",
          "end": 17
        }
      ],
      "just_unrecognised": false,
      "expected": null
    },
    {
      "name": "a selection deletes",
      "text": "call mum tomorrow",
      "selection_start": 10,
      "selection_end": 17,
      "spans": [
        {
          "key": "date:tomorrow:1",
          "end": 17
        }
      ],
      "just_unrecognised": false,
      "expected": null
    },
    {
      "name": "the second backspace deletes",
      "text": "call mum tomorrow",
      "selection_start": 17,
      "selection_end": 17,
      "spans": [
        {
          "key": "date:tomorrow:1",
          "end": 17
        }
      ],
      "just_unrecognised": true,
      "expected": null
    },
    {
      "name": "inside a word deletes",
      "text": "call mum tomorrow",
      "selection_start": 14,
      "selection_end": 14,
      "spans": [
        {
          "key": "date:tomorrow:1",
          "end": 17
        }
      ],
      "just_unrecognised": false,
      "expected": null
    },
    {
      "name": "no words, no target",
      "text": "call mum",
      "selection_start": 8,
      "selection_end": 8,
      "spans": [],
      "just_unrecognised": false,
      "expected": null
    }
  ],
