      "expected": {
        "title": "Pack bag",
        "notes": "- [ ] tent\n- [ ] stove"
      }
    },
    {
      "name": "windows and old mac line breaks",
      "pasted": "Title\r\nbody\rmore",
      "expected": {
        "title": "Title",
        "notes": "body\nmore"
      }
    },
    {
      "name": "leading blank lines are skipped",
      "pasted": "\n\n  Title  \nbody",
      "expected": {
        "title": "Title",
        "notes": "body"
      }
    },
    {
      "name": "only blank lines",
      "pasted": "\n \n \n",
      "expected": null
    },
    {
      "name": "a title over the limit spills into the notes",
      "pasted": "\nrest",
      "expected": {
        "title": "",
        "notes": "aa\nrest"
      }
    },
    {
      "name": "notes are trimmed",
      "pasted": "T\n\n\nbody\n\n",
      "expected": {
        "title": "T",
        "notes": "body"
      }
    }
  ]
}
