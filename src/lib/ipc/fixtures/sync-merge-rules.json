    },
    {
      "name": "a repeating Task completed on both sides is one occurrence",
      "steps": [
        { "d": "a", "op": "task_create", "task": "t1", "title": "Water plants" },
        {
          "d": "a",
          "op": "task_when",
          "task": "t1",
          "date": "2026-11-01",
          "time": "08:00",
          "repeat": { "freq": "day", "every": 1, "days": null, "mode": "fixed" }
        },
        { "op": "sync" },
        { "d": "a", "op": "task_done", "task": "t1" },
        { "d": "b", "op": "task_done", "task": "t1" },
        { "op": "sync" }
      ],
      "expect": {
        "tasks": { "t1": { "state": "open", "due_date": "2026-11-02", "due_time": "08:00" } },
        "occurrences": 1,
        "conflicts": 0
      }
    },
    {
      "name": "a List's sort and grouping are separate values",
      "steps": [
        { "d": "a", "op": "list_create", "list": "l1", "name": "Work" },
        { "op": "sync" },
        { "d": "a", "op": "list_sort", "list": "l1", "sort": "title" },
        { "d": "b", "op": "list_group", "list": "l1", "group": "priority" },
        { "op": "sync" }
      ],
      "expect": { "arrange": { "l1": { "sort": "title", "group": "priority" } }, "resolved": [] }
    },
    {
      "name": "a List sorted on both sides: the newest sort wins and is logged",
      "steps": [
        { "d": "a", "op": "list_create", "list": "l1", "name": "Work" },
        { "op": "sync" },
        { "d": "a", "op": "list_sort", "list": "l1", "sort": "title" },
        { "d": "b", "op": "list_sort", "list": "l1", "sort": "due" },
        { "op": "sync" }
      ],
      "expect": { "arrange": { "l1": { "sort": "due", "group": "none" } }, "resolved": ["value"] }
    },
    {
      "name": "a List grouped on both sides: the newest grouping wins and is logged",
      "steps": [
        { "d": "a", "op": "list_create", "list": "l1", "name": "Work" },
        { "op": "sync" },
        { "d": "a", "op": "list_group", "list": "l1", "group": "priority" },
        { "d": "b", "op": "list_group", "list": "l1", "group": "due" },
        { "op": "sync" }
      ],
      "expect": { "arrange": { "l1": { "sort": "manual", "group": "due" } }, "resolved": ["value"] }
    },
    {
      "name": "a text clash on a Task deleted by one of the editors is resolved and logged, not asked",
      "steps": [
        {
          "d": "a",
          "op": "task_create",
          "task": "t1",
          "title": "Hike",
          "notes": "Route: to decide\nBring the stove\n"
        },
        { "op": "sync" },
        {
          "d": "a",
          "op": "task_edit",
          "task": "t1",
          "notes": "Route: ridge loop\nBring the stove\n"
        },
        {
          "d": "b",
          "op": "task_edit",
          "task": "t1",
          "notes": "Route: lake path\nBring the stove\n"
        },
        { "d": "b", "op": "task_delete", "task": "t1" },
        { "op": "sync" }
      ],
      "expect": {
        "tasks": { "t1": { "deleted": true, "notes": "Route: lake path\nBring the stove\n" } },
        "conflicts": 0,
        "resolved": ["conflict_deleted", "delete_edit"]
      }
    },
    {
      "name": "a text clash on a Task deleted before the clash arrives is resolved and logged too",
      "steps": [
        {
          "d": "a",
          "op": "task_create",
          "task": "t1",
          "title": "Hike",
          "notes": "Route: to decide\nBring the stove\n"
        },
        { "op": "sync" },
        {
          "d": "a",
          "op": "task_edit",
          "task": "t1",
          "notes": "Route: ridge loop\nBring the stove\n"
        },
        {
          "d": "b",
          "op": "task_edit",
          "task": "t1",
          "notes": "Route: lake path\nBring the stove\n"
        },
        { "d": "a", "op": "task_delete", "task": "t1" },
        { "op": "sync" }
      ],
      "expect": {
        "tasks": { "t1": { "deleted": true } },
        "conflicts": 0,
        "resolved": ["conflict_deleted", "delete_edit"]
      }
    },
    {
      "name": "a deleted Task stays deleted through later syncs",
      "steps": [
        { "d": "a", "op": "task_create", "task": "t1", "title": "Old list" },
        { "op": "sync" },
        { "d": "a", "op": "task_delete", "task": "t1" },
        { "op": "sync" },
        { "d": "b", "op": "task_create", "task": "t2", "title": "New list" },
        { "op": "sync" },
        { "d": "a", "op": "task_priority", "task": "t2", "priority": 1 },
        { "op": "sync" }
      ],
      "expect": {
        "tasks": { "t1": { "deleted": true }, "t2": { "deleted": false, "priority": 1 } },
        "order": { "inbox": ["t2"] },
        "resolved": []
      }
    },
    {
      "name": "a deleted Entry stays deleted through later syncs",
      "steps": [
        { "d": "a", "op": "entry_create", "entry": "e1", "body": "Slept in.\n" },
        { "op": "sync" },
        { "d": "a", "op": "entry_delete", "entry": "e1" },
        { "op": "sync" },
        { "d": "b", "op": "entry_create", "entry": "e2", "body": "Read all day.\n" },
        { "op": "sync" }
      ],
      "expect": { "entries": { "e2": "Read all day.\n" }, "resolved": [] }
    },
    {
      "name": "an Entry deleted on one side and edited later on the other stays deleted and is logged",
      "steps": [
        { "d": "a", "op": "entry_create", "entry": "e1", "body": "Slept in.\n" },
        { "op": "sync" },
        { "d": "a", "op": "entry_delete", "entry": "e1" },
        { "d": "b", "op": "entry_edit", "entry": "e1", "body": "Slept in late.\n" },
        { "op": "sync" }
      ],
      "expect": { "entries": {}, "resolved": ["delete_edit"] }
    },
    {
      "name": "an Entry edited before it was deleted elsewhere, neither knowing, is logged too",
      "steps": [
        { "d": "a", "op": "entry_create", "entry": "e1", "body": "Slept in.\n" },
        { "op": "sync" },
        { "d": "b", "op": "entry_edit", "entry": "e1", "body": "Slept in late.\n" },
        { "d": "a", "op": "entry_delete", "entry": "e1" },
        { "op": "sync" }
      ],
      "expect": { "entries": {}, "resolved": ["delete_edit"] }
    }
  ]
}
