          "d": "a",
          "op": "task_when",
          "task": "t1",
          "date": "2026-11-01",
          "time": "08:00",
          "repeat": { "freq": "day", "every": 1, "days": null, "mode": "fixed" }
        },
        { "op": "sync" },
        {
          "d": "a",
          "op": "task_when",
          "task": "t1",
          "date": "2026-11-03",
          "time": "08:00",
          "repeat": { "freq": "day", "every": 2, "days": null, "mode": "fixed" }
        },
        {
          "d": "b",
          "op": "task_when",
          "task": "t1",
          "date": "2026-11-01",
          "time": "08:00",
