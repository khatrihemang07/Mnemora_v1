    { "day": -1, "at": "18:00", "do": "task_add", "key": "anika", "title": "Reply to Anika about Sunday lunch", "list": "work", "due": 0 },
    { "day": -1, "at": "18:05", "do": "comment", "key": "anika", "body": "Draft is written, it just needs sending." },
    { "day": -1, "at": "19:30", "do": "entry", "key": "e18", "page": -1,
      "text": "Walked upon the hill-tops; followed the sheep tracks till we overlooked the larger coombe. Sat in the sunshine. The distant sheep-bells, the sound of the stream; the woodman winding along the half-marked road with his laden pony; locks of wool still spangled with the dewdrops; the blue-grey sea, shaded with immense masses of cloud, not streaked; the sheep glittering in the sunshine.",
      "_source": { "book": "Journals of Dorothy Wordsworth, Vol. 1", "date": "26 January 1798" } },
    { "day": -1, "at": "23:50", "do": "task_complete", "key": "dry_cleaning" },

    { "day": 0, "at": "00:10", "do": "task_complete", "key": "anika" },
    { "day": 0, "at": "08:10", "do": "task_add", "key": "ring_grandma", "title": "Ring Grandma back", "list": null, "due": 0 },
    { "day": 0, "at": "09:05", "do": "comment", "key": "ring_grandma", "body": "Tried this morning, no answer." },
    { "day": 0, "at": "09:20", "do": "entry", "key": "e19", "page": 0,
      "text": "Walked from seven o'clock till half-past eight. Upon the whole an uninteresting evening. Only once while we were in the wood the moon burst through the invisible veil which enveloped her, the shadows of the oaks blackened, and their lines became more strongly marked.",
      "_source": { "book": "Journals of Dorothy Wordsworth, Vol. 1", "date": "27 January 1798" } }
  ]
}
