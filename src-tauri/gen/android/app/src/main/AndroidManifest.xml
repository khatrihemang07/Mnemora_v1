<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The light haptic tick when a Task is completed (navigator.vibrate): a normal permission, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:theme="@style/Theme.mnemora_app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Todo widget (ADR 0014, 0015). Not exported: only the system's explicit update
             broadcasts and this app's own package-scoped ones reach it. Enabled on Android 12+ only. -->
        <receiver
            android:name=".widget.TodoWidgetProvider"
            android:enabled="@bool/todo_widget_enabled"
            android:exported="false"
            android:label="@string/todo_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- Exempt from the implicit-broadcast limits: the day or clock changed. -->
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

        <!-- The Todo widget's setup screen: the launcher starts it when a widget is dropped and from
             long-press > reconfigure, so it must be exported. It checks that the widget is ours. -->
        <activity
            android:name=".widget.WidgetSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_setup_title"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Tick and Undo taps from the Todo widget. Only this app's own PendingIntents reach it. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:enabled="@bool/todo_widget_enabled"
            android:exported="false" />

        <!-- The open-steps question over home: translucent, its own task, kept out of Recents, never
             started by anything but the Todo widget. -->
        <activity
            android:name=".widget.StepsDialogActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.widgetdialog"
            android:theme="@style/Theme.TodoWidgetDialog" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
