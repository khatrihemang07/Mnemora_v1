<?xml version="1.0" encoding="utf-8"?>
<!-- Same as widget_card.xml, plus a soft dark shadow on the text: used when the widget has no background and a dark theme, so
     text stays readable on any wallpaper (RemoteViews cannot set a shadow at draw time). Keep both in step. -->
<!-- The Todo widget card: header, the list, and a centred message for empty and error states.
     Only views RemoteViews allows. Text is in sp, so it follows the system font size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/chip"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_circle"
                android:backgroundTint="#2900A08F">

                <ImageView
                    android:id="@+id/chip_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_check" />
            </FrameLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:textSize="12sp" />

            <!-- Pushes the gear (and, later, the + of the Quick add) to the end of the header. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/gear"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/widget_settings"
                android:padding="6dp"
                android:src="@drawable/widget_gear" />
        </LinearLayout>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/message_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/message_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The gear on cards that have no header (a deleted List): opens this widget's setup. -->
    <ImageView
        android:id="@+id/gear_corner"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/widget_settings"
        android:padding="9dp"
        android:src="@drawable/widget_gear"
        android:visibility="gone" />

    <!-- The Sandbox build's amber tab at the top centre of the card. -->
    <TextView
        android:id="@+id/sandbox_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/widget_tag"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:text="@string/widget_sandbox_tag"
        android:textColor="@color/widget_sandbox_tag_text"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
