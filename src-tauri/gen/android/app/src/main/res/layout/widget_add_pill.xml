<?xml version="1.0" encoding="utf-8"?>
<!-- The Todo widget below 3x2 and from 100 dp wide: one "Add a task..." pill that opens Quick add. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg">

    <LinearLayout
        android:id="@+id/add_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_field"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/add_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_plus" />

        <TextView
            android:id="@+id/add_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_add_task"
            android:fontFamily="sans-serif-medium"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sandbox_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/widget_tag"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:text="@string/widget_sandbox_tag"
        android:textColor="@color/widget_sandbox_tag_text"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
