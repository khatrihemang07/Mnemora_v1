<?xml version="1.0" encoding="utf-8"?>
<!-- Same as widget_group.xml, plus a soft dark shadow on the text: used when the widget has no background and a dark theme, so
     text stays readable on any wallpaper (RemoteViews cannot set a shadow at draw time). Keep both in step. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:letterSpacing="0.04"
    android:maxLines="1"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp"
    android:shadowColor="#E6000000"
    android:shadowDx="0"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:textSize="11sp"
    android:textStyle="bold" />
