<?xml version="1.0" encoding="utf-8"?>
<!-- Shown before the first real draw (and as the picker preview): the card shell with faint rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:backgroundTint="@color/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_circle"
            android:backgroundTint="@color/widget_surface2" />

        <View
            android:layout_width="64dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_surface2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_surface2" />

        <View
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_surface2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_surface2" />

        <View
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="80dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_surface2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_surface2" />

        <View
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="24dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:backgroundTint="@color/widget_surface2" />
    </LinearLayout>
</LinearLayout>
