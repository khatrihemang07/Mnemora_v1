    <color name="widget_you_accent">#FF615CDC</color>
    <color name="widget_you_todo">#FF00A08F</color>
    <color name="widget_you_on_todo">#FFFCFCFC</color>
    <color name="widget_you_dark_bg">#FF191511</color>
    <color name="widget_you_dark_surface2">#FF221D19</color>
    <color name="widget_you_dark_ink">#FFEEEBE5</color>
    <color name="widget_you_dark_muted">#FF9E9790</color>
