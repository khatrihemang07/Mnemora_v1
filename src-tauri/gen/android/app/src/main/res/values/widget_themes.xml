<?xml version="1.0" encoding="utf-8"?>
<!-- The Todo widget's themes, hand-converted from src/lib/theme/tokens.css. The card surface is the
     surface token (True black: pure black, the oled bg). The Priority ring colours (danger, warning,
     accent) keep their meaning in every theme, Material You included. Material You colours come
     from the system palette on Android 12+ (values-v31/); the values here are only the fallback. -->
<resources>
    <color name="widget_light_bg">#FFFFFFFF</color>
    <color name="widget_light_surface2">#FFF5EFE9</color>
    <color name="widget_light_ink">#FF1D1712</color>
    <color name="widget_light_muted">#FF6A615A</color>
    <color name="widget_light_faint">#FF8C857E</color>
    <color name="widget_light_danger">#FFC2181D</color>
    <color name="widget_light_warning">#FFE48E26</color>
    <color name="widget_light_accent">#FF615CDC</color>
    <color name="widget_light_todo">#FF00A08F</color>
    <color name="widget_light_on_todo">#FFFCFCFC</color>
    <color name="widget_dark_bg">#FF191511</color>
    <color name="widget_dark_surface2">#FF221D19</color>
    <color name="widget_dark_ink">#FFEEEBE5</color>
    <color name="widget_dark_muted">#FF9E9790</color>
    <color name="widget_dark_faint">#FF7F7973</color>
    <color name="widget_dark_danger">#FFF66D62</color>
    <color name="widget_dark_warning">#FFE48E26</color>
    <color name="widget_dark_accent">#FF9499FA</color>
    <color name="widget_dark_todo">#FF00A08F</color>
    <color name="widget_dark_on_todo">#FF0F101F</color>
    <color name="widget_oled_bg">#FF000000</color>
    <color name="widget_oled_surface2">#FF111114</color>
    <color name="widget_oled_ink">#FFEEEBE5</color>
    <color name="widget_oled_muted">#FF9E9790</color>
    <color name="widget_oled_faint">#FF7F7973</color>
    <color name="widget_oled_danger">#FFF66D62</color>
    <color name="widget_oled_warning">#FFE48E26</color>
    <color name="widget_oled_accent">#FF9499FA</color>
    <color name="widget_oled_todo">#FF00A08F</color>
    <color name="widget_oled_on_todo">#FF0F101F</color>
    <color name="widget_you_bg">#FFFFFFFF</color>
    <color name="widget_you_surface2">#FFF5EFE9</color>
    <color name="widget_you_ink">#FF1D1712</color>
